# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Database (Supabase Postgres). Use the SESSION pooler (port 5432) or a direct connection.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI. URL-encode special
# characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- LLM (Gemini). Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini            # gemini | none (none = template explanations, no LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Admin API: long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`.
# For scripts / automation. Signed-in admin accounts (see ADMIN_EMAILS) do not need it.
# Empty = only admin accounts can use the admin endpoints.
ADMIN_API_TOKEN=

# --- Supabase Auth: e-mail + password sign-in, accounts, saved conversations and history
# Project URL: https://<project-ref>.supabase.co (Project Settings -> API). The backend verifies sign-in
# tokens with the project's public signing keys fetched from this URL.
SUPABASE_URL=
# Public anon / publishable key, used by the browser (docker compose passes it to the frontend build).
SUPABASE_ANON_KEY=
# Only for projects still using the legacy shared JWT secret (Project Settings -> API -> JWT secret).
# Backend only, never in the frontend. Leave empty if the project uses JWT signing keys.
SUPABASE_JWT_SECRET=
# Comma-separated e-mails that become admins when they sign in (bootstraps the first administrator).
ADMIN_EMAILS=

# --- Web
CORS_ORIGINS=http://localhost:3100

# --- Collection tuning (defaults shown)
# PER_DOMAIN_MIN_INTERVAL_SECONDS=5
# COLLECTION_CONCURRENCY=2
# COLLECTION_MAX_RETRIES=3
# HTTP_TIMEOUT_SECONDS=20
# BROWSER_TIMEOUT_SECONDS=60
# EXTRA_ALLOWED_HOSTS=

# --- Vendor cache TTLs in hours (starting points, not offer-validity guarantees)
# TTL_EMI_HOURS=12
# TTL_VENDOR_PRICE_HOURS=1
# TTL_REVIEW_AGGREGATE_HOURS=24
# TTL_REVIEW_SAMPLES_HOURS=168

# --- Alerts
# ALERT_COOLDOWN_HOURS=24
# SIGNIFICANT_DROP_PERCENT=5

# --- docker compose host ports
# API_PORT=8001
# WEB_PORT=3100
