# Public URL of the FastAPI backend (this value is visible in the browser; it is not a secret).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase Auth (public values: project URL and the anon / publishable key - NEVER the service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
